{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",

  // NOT redundant — do not delete. The root config extends
  // `ultracite/biome/next`, whose Next.js-only rules fire on this Vite app.
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      // There is no next/image in a Vite app to prefer over <img>.
      "performance": { "noImgElement": "off" }
    }
  },
  "overrides": [
    {
      // The drawing and the stage are generative code: seeded random numbers
      // are bit arithmetic (`Math.imul`, `>>> 0`), and pixel and point loops
      // count with `++`. Both rules are right for app code and wrong here.
      "includes": ["art/**", "src/stage/**"],
      "linter": {
        "rules": {
          "style": { "noIncrementDecrement": "off" },
          "suspicious": { "noBitwiseOperators": "off" }
        }
      }
    }
  ]
}
