{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Vite, so the root's Next.js outputs are replaced. `dev`, `lint` and
    // `typecheck` are inherited from the root as-is — redefining them here only
    // restated what they already were.
    "build": { "outputs": ["dist/**"] }
  }
}
