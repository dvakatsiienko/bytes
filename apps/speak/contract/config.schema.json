{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "settings": {
      "properties": {
        "favourites": { "items": { "type": "string" }, "type": "array" },
        "gain": { "default": 1, "maximum": 4, "minimum": 0, "type": "number" },
        "model": { "type": "string" },
        "speed": {
          "default": 1,
          "maximum": 3,
          "minimum": 0.5,
          "type": "number"
        },
        "voice": {
          "additionalProperties": { "type": "string" },
          "propertyNames": { "enum": ["en", "uk", "ru", "*"] },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "chain": {
      "additionalProperties": {
        "items": { "type": "string" },
        "type": "array"
      },
      "propertyNames": { "enum": ["en", "uk", "ru"] },
      "type": "object"
    },
    "cleaner": {
      "additionalProperties": false,
      "properties": {
        "dictionary": {
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              {
                "additionalProperties": false,
                "properties": {
                  "anyCase": { "default": false, "type": "boolean" },
                  "say": { "type": "string" }
                },
                "required": ["say"],
                "type": "object"
              }
            ]
          },
          "type": "object"
        },
        "rules": {
          "additionalProperties": false,
          "properties": {
            "addresses": { "default": true, "type": "boolean" },
            "codeBlocks": { "default": true, "type": "boolean" },
            "codeNames": { "default": true, "type": "boolean" },
            "dates": { "default": true, "type": "boolean" },
            "emoji": { "default": true, "type": "boolean" },
            "fileLinks": { "default": true, "type": "boolean" },
            "ids": { "default": true, "type": "boolean" },
            "lineEnds": { "default": true, "type": "boolean" },
            "lists": { "default": true, "type": "boolean" },
            "markdown": { "default": true, "type": "boolean" },
            "paths": { "default": true, "type": "boolean" },
            "symbols": { "default": true, "type": "boolean" },
            "ticketIds": { "default": true, "type": "boolean" },
            "units": { "default": true, "type": "boolean" },
            "urls": { "default": true, "type": "boolean" },
            "versions": { "default": true, "type": "boolean" },
            "words": { "default": true, "type": "boolean" }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "engines": {
      "additionalProperties": { "$ref": "#/$defs/settings" },
      "type": "object"
    },
    "firstAudioMs": { "maximum": 3000, "minimum": 100, "type": "integer" },
    "meterFlowMs": {
      "default": 40,
      "maximum": 200,
      "minimum": 0,
      "type": "number"
    },
    "meterGlideMs": {
      "default": 30,
      "maximum": 200,
      "minimum": 0,
      "type": "number"
    },
    "volume": { "default": 100, "maximum": 100, "minimum": 0, "type": "number" }
  },
  "required": ["chain", "engines", "firstAudioMs"],
  "type": "object"
}
