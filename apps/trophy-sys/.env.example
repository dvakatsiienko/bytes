# NPSSO comes from .env; the KV pair is pulled into .env.local by `vercel env pull`.
# For local work, .env.dev.local loads last and blanks the KV pair so dev cannot
# reach the production store. See that file for the dev-redis recipe.
NPSSO=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Steam. The key is per-account from steamcommunity.com/dev/apikey; the id is
# the 64-bit one, not the vanity name — the vanity does not resolve.
# The steam-game verb additionally needs "Game details" set to Public in Steam's
# privacy settings, which is separate from "My profile".
STEAM_API_KEY=
STEAM_ID64=
