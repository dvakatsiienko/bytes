{
  "name": "trophy-sys",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node --run dev:api & node --run dev:web",
    "dev:api": "node --watch --env-file=.env --env-file-if-exists=.env.local src/server/main.ts",
    "dev:web": "vite",
    "lint": "biome lint",
    "preview": "vite preview",
    "trophies": "node --env-file=.env --env-file-if-exists=.env.local src/server/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.29",
    "@upstash/redis": "1.38.2",
    "psn-api": "2.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.3.3",
    "vite": "8.2.1"
  }
}
