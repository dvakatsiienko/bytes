{
  "name": "trophy-sys",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node --run build:web && node --run build:api",
    "build:api": "esbuild src/server/handler.ts --bundle --platform=node --format=esm --target=node24 --outfile='api/[...path].js'",
    "build:web": "vite build",
    "dev": "node --run dev:api & node --run dev:web",
    "dev:api": "node --watch --env-file=.env src/server/main.ts",
    "dev:web": "vite",
    "lint": "biome lint",
    "preview": "vite preview",
    "trophies": "node --env-file=.env src/server/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "psn-api": "2.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
