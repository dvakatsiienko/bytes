{
  "name": "trophy-sys",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../script/with-port.ts 5177 node --run dev:api & node ../../script/with-port.ts 5177 node --run dev:web",
    "dev:api": "node --watch --env-file=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.dev.local src/server/main.ts",
    "dev:web": "vite",
    "build": "node --run build:web && node --run build:api && node --run build:output",
    "build:api": "esbuild src/server/handler.ts --bundle --platform=node --format=esm --target=node24 --outfile=.vercel/output/functions/api/handler.func/index.js --allow-overwrite",
    "build:output": "node script/vercel-output.ts",
    "build:web": "vite build",
    "preview": "vite preview",
    "trophies": "node --env-file=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.dev.local src/server/cli.ts",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@ui/kit": "workspace:*",
    "@upstash/redis": "1.38.3",
    "@visx/axis": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@visx/tooltip": "4.0.0",
    "lucide-react": "1.41.0",
    "motion": "13.1.1",
    "psn-api": "2.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "esbuild": "0.28.2"
  }
}
