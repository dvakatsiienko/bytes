{
  "name": "trophy-sys",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node --run build:web && node --run build:api",
    "build:api": "esbuild src/server/handler.ts --bundle --platform=node --format=esm --target=node24 --outfile=api/handler.js --allow-overwrite",
    "build:web": "vite build",
    "dev": "node --run dev:api & node --run dev:web",
    "dev:api": "node --watch --env-file=.env --env-file-if-exists=.env.local src/server/main.ts",
    "dev:web": "vite",
    "lint": "biome lint",
    "preview": "vite preview",
    "trophies": "node --env-file=.env --env-file-if-exists=.env.local src/server/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@upstash/redis": "1.38.3",
    "@visx/axis": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@visx/tooltip": "4.0.0",
    "motion": "13.1.1",
    "psn-api": "2.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "oxc-transform-react": "0.148.0",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  }
}
