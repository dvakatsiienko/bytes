{
  "$schema": "https://v2-10-0.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "outputs": ["dist/**"],
      // Biome's noUndeclaredEnvVars reads this list, so every process.env
      // key the app touches must appear here.
      "env": ["NPSSO", "API_PORT", "KV_REST_API_URL", "KV_REST_API_TOKEN"]
    },
    "lint": {},
    "typecheck": {}
  }
}
