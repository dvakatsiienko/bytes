{
  "name": "bytes",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Dima Vakatsiienko <imagnum.satellite@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:@space-explorer/api": "turbo run @space-explorer/api#dev",
    "dev:@space-explorer/ui": "turbo run @space-explorer/ui#dev",
    "dev:cv": "turbo run cv#dev",
    "dev:figmentation": "turbo run figmentation#dev",
    "dev:financial": "turbo run financial#dev",
    "dev:proto-lab": "turbo run proto-lab#dev",
    "dev:trophy-sys": "turbo run trophy-sys#dev",
    "dev:x-com-chat": "turbo run x-com-chat#dev x-com-chat#dev:convex",
    "build": "turbo run build",
    "build:cv": "turbo run cv#build",
    "build:figmentation": "turbo run figmentation#build",
    "build:financial": "turbo run financial#build",
    "build:space-explorer/ui": "turbo run @space-explorer/ui#build",
    "build:trophy-sys": "turbo run trophy-sys#build",
    "build:x-com-chat": "turbo run x-com-chat#build",
    "packages:reinstall": "pnpm dlx rimraf node_modules \"**/node_modules\" \"**/.next\" pnpm-lock.yaml && pnpm install",
    "pretest": "playwright install chromium",
    "prettier-config:publish": "pnpm -F='prettier-config-polished' publish",
    "turbo:devtools": "turbo devtools",
    "worktree:seed": "node ./script/worktree-seed.ts",
    "lint": "turbo run lint",
    "lint:errors": "biome lint --diagnostic-level=error",
    "lint:report": "biome lint --reporter=summary",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "check": "turbo run lint typecheck",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@graphql-codegen/cli": "7.4.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "biome-config-polished": "workspace:*",
    "lefthook": "2.1.12",
    "npm-run-all2": "9.0.3",
    "oxc-transform-react": "0.148.0",
    "playwright": "1.63.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-config-polished": "workspace:*",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "ultracite": "7.10.7",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vitest-browser-react": "2.3.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.3.4"
}
