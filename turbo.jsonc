{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  // Declaring this list makes turbo strip every OTHER env var from task
  // environments, so anything the tasks genuinely need must be named here.
  "globalPassThroughEnv": [
    "ENABLE_EXPERIMENTAL_COREPACK",
    "DATABASE_URL",
    "AUTH_SECRET",
    "PORT",
    "PORT_OFFSET",
    "API_PORT"
  ],
  "tasks": {
    // A no-op task with no matching script anywhere. It exists so `lint` and
    // `typecheck` can depend on their dependencies' SOURCE without waiting for
    // their dependencies' lint/typecheck to finish: `^lint` would serialise the
    // graph, and no dependsOn at all would let a stale cache survive a change in
    // a package you import. This is turbo's "transit node" pattern.
    //
    // The exclusions matter more than they look. A task that depends on
    // `transit` folds transit's hash into its own, so an exclusion declared
    // only on that task is inert — measured on `test`: its own inputs dropped
    // CLAUDE.md (80 vs 82), and editing CLAUDE.md still missed the cache,
    // because transit had counted the file.
    //
    // Declared here, the exclusion reaches every task that also declares it.
    // Today that is `test` alone: measured on a CLAUDE.md edit, `test` replays
    // from cache while `lint` and `typecheck` still miss, because their own
    // inputs count the file. That is the correct reading of both — a doc
    // cannot change a test result, and `lint` may one day lint the doc.
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!CLAUDE.md",
        "!**/README.md",
        "!.vscode/**"
      ]
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^prisma:generate"]
    },
    "serve": { "cache": false, "persistent": true },
    "dev:convex": { "cache": false, "persistent": true },

    "build": {
      // `prisma:generate`, not `^prisma:generate`: the client a package builds
      // against is its OWN, and `^` only reaches dependencies. It used to work
      // by accident, through typecheck, which did name it correctly.
      //
      // lint and typecheck are deliberately NOT here. CI gates both on every PR
      // and push, so requiring them made each Vercel deploy run five tasks to
      // produce one artifact, and let a lint error fail a deploy.
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "inputs": [
        "$TURBO_DEFAULT$",

        // Tracked .env files are already covered by $TURBO_DEFAULT$; this is
        // for the gitignored *.local ones, which a build still reads.
        ".env*",

        // Only paths that can actually match INSIDE a package earn a line here.
        // Task inputs are package-relative, so a root-level file can never match
        // — and root files are not part of a package's hash to begin with
        // (measured: editing lefthook.yaml leaves every task hash untouched).
        "!CLAUDE.md",
        "!**/README.md",
        "!.vscode/**"
      ]
    },

    "lint": { "dependsOn": ["transit"] },

    // Turbo skips every package without a `test` script, so this task covers
    // the whole graph whoever has one. Deliberately not listing them: the same
    // sentence in ci.yml named two packages and went stale the day a third
    // arrived. Every suite is `vitest run` over source, so they need the
    // generated Prisma client but never a build.
    //
    // This is the CI lane: one cacheable task per package. The root
    // `pnpm test` is the other door — a single vitest run over every project,
    // for a human who wants one readable pass.
    "test": {
      "dependsOn": ["transit", "prisma:generate"],
      // No `outputs`. A test run's product is its exit code and its log, and
      // turbo caches both without a declaration. `coverage/` is written only
      // by `pnpm test:coverage` at the root, which is not this task.
      "inputs": [
        "$TURBO_DEFAULT$",
        "!CLAUDE.md",
        "!**/README.md",
        "!.vscode/**"
      ]
    },

    "typecheck": {
      "dependsOn": ["transit", "prisma:generate"],
      "description": "Checks TypeScript code for errors",
      // No `outputs` on purpose. Four apps set `incremental: true` and write
      // tsconfig.tsbuildinfo, so caching it looks free — it is not worth it:
      // turbo restores outputs only on a cache HIT, and on a hit tsc never runs,
      // so the restored file is not read. On a MISS nothing is restored, so a
      // cold CI run always typechecks from scratch either way. Declaring the
      // glob only earned five "no output files found" warnings from the
      // packages that are not incremental.
      // $TURBO_DEFAULT$ already covers package.json, tsconfig.json and every
      // .ts/.tsx file; listing them again only made the config look tighter
      // than it was.
      "inputs": ["$TURBO_DEFAULT$"]
    },

    "prisma:generate": {
      "inputs": ["prisma/**", "package.json"],
      // The generated client lands here (both schemas set `output`). Undeclared,
      // it was regenerated every run and a cache hit restored nothing.
      "outputs": [".generated/prisma/**"]
    }
  }
}
